# ============================================================
# Financial AI Pipeline — Environment Configuration
# ============================================================

# --- LLM Provider (DeepSeek) ---
# Uses OpenAI-compatible SDK. Works with DeepSeek official API
# or any OpenAI-compatible local proxy (Ollama, vLLM, etc.)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Storage ---
SQLITE_DB_PATH=data/pipeline.db
RAW_STORE_PATH=data/raw

# --- RAG (off by default; see src/config.py) ---
RAG_ENABLED=false

# --- Pipeline ---
MAX_RETRIES=3
CLASSIFY_MAX_RETRIES=2
LOG_LEVEL=INFO

# --- E1 evaluation (scripts/eval_classification.py only; not a pipeline setting) ---
# Default for --dataset. The dataset stays outside the repo and is only read;
# results are written under results/e1/.
# E1_DATASET=/path/to/e1_classification/e1_dataset_draft.jsonl
